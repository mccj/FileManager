<!DOCTYPE html>
<html lang="zh-CN">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Razor Pages · Full</title>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet" />
    <link rel="stylesheet" href="~/css/site.css" />
</head>
<body>
    <nav class="navbar navbar-expand-lg navbar-dark bg-dark mb-4">
        <div class="container">
            <a class="navbar-brand" asp-page="/Index">Razor Pages · Full</a>
            <div class="navbar-nav">
                <a class="nav-link" asp-page="/Index">首页</a>
                <a class="nav-link" href="/Browser/">文件管理器</a>
                <a class="nav-link" href="/swagger" target="_blank">Swagger</a>
                <a class="nav-link" href="/health" target="_blank">健康检查</a>
            </div>
        </div>
    </nav>
    <main class="container pb-5">
        @RenderBody()
    </main>
    <footer class="border-top text-muted py-3 mt-4">
        <div class="container">&copy; @DateTime.UtcNow.Year - FileManager Sample (Razor Pages · Full)</div>
    </footer>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
