<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <appSettings>
    <add key="FileManager:Storage:Provider" value="Physical" />
    <add key="FileManager:Storage:Physical:Path" value="App_Data\Files" />
    <add key="FileManager:Storage:Compress:ArchivePath" value="App_Data\sample.zip" />
  </appSettings>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
</configuration>
