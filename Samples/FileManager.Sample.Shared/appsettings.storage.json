{

  "FileManager": {

    "Storage": {

      "Provider": "Physical",

      "Physical": {

        "Path": "/App_Data/Files"

      },

      "Compress": {

        "ArchivePath": "App_Data/sample.zip"

      },

      "Ftp": {

        "Host": "ftp://127.0.0.1/",

        "Port": 21,

        "User": "anonymous",

        "Password": ""

      },

      "WebDav": {

        "Url": "http://127.0.0.1/webdav/",

        "User": "",

        "Password": ""

      },

      "MongoDB": {

        "ConnectionString": "mongodb://127.0.0.1:27017/"

      },

      "MultiDrive": {

        "PhysicalPath": "App_Data/Files"

      },

      "AzureBlob": {

        "ConnectionString": "UseDevelopmentStorage=true",

        "ContainerName": "filemanager"

      },

      "AwsS3": {

        "BucketName": "filemanager-demo",

        "Region": "us-east-1",

        "AccessKey": "",

        "SecretKey": ""

      }

    },

    "Showcase": {

      "MountMode": "Lite"

    }

  }

}


