<Project Sdk="Microsoft.NET.Sdk">







  <PropertyGroup>



    <TargetFrameworks>net8.0;netstandard2.1;netstandard2.0;net48</TargetFrameworks>



    <Version>1.0.0</Version>



    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>

    <EnableDashboardEmbeddedContent Condition="'$(TargetFramework)' == 'net8.0'">true</EnableDashboardEmbeddedContent>

    <DashboardContentFolder>Content</DashboardContentFolder>

    <DashboardContentNamespace>$(AssemblyName).Content</DashboardContentNamespace>



  </PropertyGroup>







  <ItemGroup>



    <Compile Remove="Content\**\*" />

    <None Remove="Content\**\*" />



  </ItemGroup>



  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">



    <EmbeddedResource Remove="Content\**\*" />



  </ItemGroup>







  <ItemGroup>



    <PackageReference Include="Microsoft.Extensions.Caching.Abstractions" Version="10.0.9" />



    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />



    <PackageReference Include="Microsoft.AspNetCore.StaticFiles" Version="2.3.11" />



    <PackageReference Include="AspNetCoreDashboard.Abstractions" Version="1.0.0-beta-20" />



  </ItemGroup>







  <ItemGroup Condition="'$(TargetFramework)' == 'net8.0'">



    <PackageReference Include="AspNetCoreDashboard" Version="1.0.0-beta-20" />



    <PackageReference Include="SixLabors.ImageSharp" Version="3.1.12" />



  </ItemGroup>







  <ItemGroup Condition="'$(TargetFramework)' != 'net8.0'">



    <PackageReference Include="SixLabors.ImageSharp" Version="2.1.13" />

    <PackageReference Include="System.IO.Compression" Version="4.3.0" />



  </ItemGroup>









  <ItemGroup>



    <ProjectReference Include="..\FileManager.Core\FileManager.Core.csproj" />



  </ItemGroup>







</Project>


