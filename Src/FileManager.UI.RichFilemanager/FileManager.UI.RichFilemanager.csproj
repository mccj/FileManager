<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>netstandard2.1</TargetFrameworks>
    <Version>1.0.0</Version>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <EnableDashboardEmbeddedContent>true</EnableDashboardEmbeddedContent>
    <DashboardContentFolder>Content</DashboardContentFolder>
    <DashboardContentNamespace>$(AssemblyName).Content</DashboardContentNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Newtonsoft.Json" Version="13.0.4" />
    <PackageReference Include="AspNetCoreDashboard.Abstractions" Version="1.0.0-beta-20" />
  </ItemGroup>

  <ItemGroup>
    <Compile Remove="Content\**\*" />
    <None Remove="Content\**\*" />
  </ItemGroup>

  <!-- Exclude PHP connector samples so MapCommand can handle /connectors/php/filemanager.php -->
  <Target Name="ExcludePhpConnectorsFromEmbed" BeforeTargets="GenerateDashboardEmbeddedResourceManifest;AssignTargetPaths;CoreCompile">
    <ItemGroup>
      <EmbeddedResource Remove="@(EmbeddedResource)" Condition="$([System.String]::Copy('%(Identity)').Replace('/','\').Contains('\connectors\'))" />
    </ItemGroup>
  </Target>

  <!--
    AspNetCoreDashboard.EmbeddedResourcePathHelper.ToResourceName converts '-' to '_'
    only in directory segments, not in the file name. Rebuild LogicalName the same way.
  -->
  <Target Name="NormalizeDashboardEmbeddedHyphens" AfterTargets="ExcludePhpConnectorsFromEmbed" BeforeTargets="GenerateDashboardEmbeddedResourceManifest;CoreCompile">
    <ItemGroup>
      <_DashboardEmbedFixed Include="@(EmbeddedResource)">
        <LogicalName>$(DashboardContentNamespace).$([System.String]::Copy('%(RecursiveDir)').Replace('\','.').Replace('/','.').Replace('-','_'))%(Filename)%(Extension)</LogicalName>
      </_DashboardEmbedFixed>
      <EmbeddedResource Remove="@(EmbeddedResource)" />
      <EmbeddedResource Include="@(_DashboardEmbedFixed)" />
    </ItemGroup>
  </Target>

  <ItemGroup>
    <ProjectReference Include="..\FileManager.Core\FileManager.Core.csproj" />
  </ItemGroup>

</Project>
